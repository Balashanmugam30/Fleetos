{
  "name": "fleetos-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Fleetos — Agentic Multimodal Fleet Intelligence Platform",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "lint:web": "pnpm --filter web lint",
    "typecheck:web": "pnpm --filter web typecheck",
    "dev:api": "python -m uvicorn services.api.app.main:app --reload --port 8000",
    "test:api": "python -m pytest services/api",
    "test:shared": "python -c \"import ortools; print('OR-Tools version:', ortools.__version__)\""
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
