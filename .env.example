# FLEETOS PLATFORM ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env for local development. Never commit .env to source control!

# -----------------------------------------------------------------------------
# 1. SERVER-SIDE DATABASE & BACKEND (FastAPI / PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fleetos_db
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# 2. VAPI VOICE TELEPHONY INTEGRATION (Server-Side Only)
# -----------------------------------------------------------------------------
VAPI_API_KEY=your_vapi_api_key_here
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id_here
VAPI_ASSISTANT_ID=your_vapi_assistant_id_here
VAPI_SERVER_SECRET=your_vapi_webhook_secret_verification_token

# -----------------------------------------------------------------------------
# 3. TWILIO TELEPHONY GATEWAY (Server-Side Only)
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# -----------------------------------------------------------------------------
# 4. AI & AGENT ORCHESTRATION LLM PROVIDERS (Server-Side Only)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# 5. MAPPING & GEOSPATIAL SERVICES (Client & Server)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_public_access_token_here
MAPBOX_SECRET_TOKEN=your_mapbox_secret_token_here

# -----------------------------------------------------------------------------
# 6. APPLICATION BASE URLS & DEMO SETTINGS
# -----------------------------------------------------------------------------
PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
DEMO_MODE=true
AR_ENVIRONMENT=webar
